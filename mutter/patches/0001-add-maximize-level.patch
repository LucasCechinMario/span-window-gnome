+void
+meta_window_set_maximize_level (MetaWindow *window,
+                                guint       level)
+{
+  g_return_if_fail (META_IS_WINDOW (window));
+
+  if (level > 3)
+    level = 3;
+
+  window->maximize_level = level;
+}
+
+guint
+meta_window_get_maximize_level (MetaWindow *window)
+{
+  g_return_val_if_fail (META_IS_WINDOW (window), 0);
+
+  return window->maximize_level;
+}
